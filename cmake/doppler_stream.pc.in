# Written at install time in the same two flavours as doppler.pc (see there):
# a literal /usr for the packages, a location-derived relocatable prefix
# otherwise. No rpath here either; see the note on Libs in doppler.pc.
prefix=@DOPPLER_PC_PREFIX@
exec_prefix=${prefix}
libdir=${exec_prefix}/@DOPPLER_PC_LIBDIR@
includedir=${prefix}/@DOPPLER_PC_INCLUDEDIR@

Name: doppler_stream
Description: doppler NATS stream component (dp_pub_*/dp_sub_* wire layer)
Version: @DOPPLER_PC_VERSION@
# Requires pulls in the core's flags, so one name gives the whole link
# line: `pkg-config --cflags --libs doppler_stream`. The vendored nats.c
# is statically embedded in both library forms — no external NATS client
# library at build or run time.
Requires: doppler
Libs: -L${libdir} -ldoppler_stream
Libs.private: -lpthread -lm
Cflags: -I${includedir}
