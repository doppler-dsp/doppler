# syntax=docker/dockerfile:1
# deploy/docker/Dockerfile.cli — the runtime "try doppler" image, published
# every release as ghcr.io/doppler-dsp/doppler:X.Y.Z (+ :latest),
# linux/amd64 + linux/arm64.
#
# Both architectures install the published PyPI wheel: release.yml builds
# manylinux_2_28 wheels for x86_64 AND aarch64 (the latter natively on
# GitHub's arm64 runners), the wheels bundle their shared-lib deps via
# auditwheel repair, so no build toolchain is needed on either platform
# and the image is guaranteed to run the exact artifact the release
# workflow already smoke-tested — never an independent rebuild that
# could drift from it. (Before v0.32.0 the arm64 layer had no wheel and
# compiled the whole tree from source under QEMU: ~19 min of emulated
# build per release, all deleted by publishing the aarch64 wheel.)
#
# --only-binary keeps that guarantee fail-closed: if the wheel for this
# platform is ever missing from PyPI, pip errors out instead of silently
# falling back to an sdist source build.
#
# On top of the wheel this image adds the scientific stack the gallery demos
# need (numpy is already a wheel dep; matplotlib + scipy are not) and COPYs
# the example scripts — which ship in the repo but NOT in the wheel — so a
# `docker run` lands you among runnable demos instead of a bare help screen.
#
# Usage:
#   docker run --rm -it ghcr.io/doppler-dsp/doppler:latest   # shell in /examples
#   docker run --rm ghcr.io/doppler-dsp/doppler:latest python awgn_demo.py
#   docker run --rm ghcr.io/doppler-dsp/doppler:latest doppler --help
#   docker run --rm ghcr.io/doppler-dsp/doppler:latest wfmgen --help
FROM python:3.12-slim
ARG DOPPLER_VERSION

# The install retries with backoff: release.yml's "wait for PyPI" guard
# polls from the RUNNER, but this pip runs inside the buildx container on
# a potentially different (not-yet-purged) CDN edge — the v0.29.0 release
# hit exactly that: the runner saw the version, the build's simple-index
# shard still ended at the previous release.
#
# Only doppler-dsp is pinned to --only-binary (fail-closed on a missing
# wheel); matplotlib/scipy resolve their own wheels normally. They are
# installed in the SAME retrying step so a not-yet-indexed release can't
# leave a half-provisioned image.
RUN ok=""; \
    for i in 1 2 3 4 5 6; do \
        pip install --no-cache-dir --only-binary doppler-dsp \
            "doppler-dsp[cli,specan-web]==${DOPPLER_VERSION}" \
            matplotlib scipy \
            && { ok=1; break; }; \
        echo "PyPI index not caught up (attempt $i/6); retrying..."; \
        sleep 30; \
    done; \
    [ -n "$ok" ]

# The demos live in the repo but are excluded from the wheel, so COPY them
# from the build context (release.yml builds with context=.). A headless
# Agg backend lets every matplotlib `savefig` demo run without a display.
ENV MPLBACKEND=Agg
COPY src/doppler/examples/ /examples/
COPY deploy/docker/runtime-README.md /examples/README.md
WORKDIR /examples

# Land in a shell among the demos by default; the CLIs are still one word away
# (`doppler --help`, `wfmgen --help`) since they're on PATH from the wheel.
CMD ["/bin/bash"]
