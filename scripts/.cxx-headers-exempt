# Installed headers that do not parse as C++ yet (doppler#3108).
#
# Read by scripts/check_cxx_headers.py (`make cxx-headers-check`). One header
# a line, then `#` and the reason: the first thing g++ or clang++ refuses,
# and the header it is in when that is not this one. The list only shrinks:
# the gate fails on a header that is missing from it, and on a line whose
# header now parses. What crosses into C++ and what does not is
# native/inc/doppler/dp_complex.h, "From C++".
doppler/RateConverter/RateConverter_core.h  # an inline body uses the C99 complex library (`crealf`), via agc/agc_core.h
