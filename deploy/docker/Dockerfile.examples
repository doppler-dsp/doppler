# syntax=docker/dockerfile:1
#
# deploy/docker/Dockerfile.examples — the "build ON doppler" images.
#
# Prefer the Makefile, which is the single driver for every docker build here:
#
#   make docker-sdk             # → the SDK / develop image
#   make docker-downstream      # → the iqtools showcase image
#   make docker-stream          # → the lean compose streaming-services image
#
# The raw equivalents (what those targets run) are:
#
#   docker build -f deploy/docker/Dockerfile.examples --target sdk           -t doppler-sdk .
#   docker build -f deploy/docker/Dockerfile.examples --target downstream-jm -t doppler-downstream-jm .
#   docker build -f deploy/docker/Dockerfile.examples --target stream-services -t doppler-stream-services .
#
# One shared builder (`doppler-build`) compiles and *installs* THIS checkout's
# doppler exactly once; every image below copies from it, so all three are
# version-locked to the same source — a downstream `find_package(doppler)`
# resolves the very library that was built beside it, never a drifting pin.
#
# Targets:
#   sdk             — dev toolchain + uv + the pinned just-makeit + doppler
#                     installed to /usr/local, and every consuming example's
#                     SOURCE under /workspace. "Everything you need to build
#                     on doppler."
#   downstream-jm   — the iqtools showcase: doppler installed, iqtools already
#                     built and its full suite green, jm ready to re-generate.
#                     Lands you in /iqtools.
#   stream-services — a lean runtime carrying just the native/examples streaming
#                     binaries (transmitter / receiver / spectrum_analyzer)
#                     that docker-compose.yml runs. No toolchain, no Python.
# ---------------------------------------------------------------------------

# The glibc-floor toolchain, by tag. Declared before the first FROM so it is
# a global build ARG usable in a later FROM. It is NOT pulled from a registry:
# `make docker-stream` builds it from deploy/docker/Dockerfile.glibc228 first,
# which is why that Makefile target — not a bare `docker compose up` — is the
# entry point for the stream image. Keep the default in step with the
# Makefile's GLIBC_IMAGE (= $(DOCKER_IMAGE)-glibc228:$(DOCKER_TAG)).
ARG GLIBC_BASE=doppler-glibc228:dev

# ── Stage 1: build + install doppler from this checkout ────────────────────
# BUILD_PYTHON=OFF: none of these images need doppler's own Python extension
# (the SDK builds downstream *bindings*, not doppler's), so the builder stays
# a pure C toolchain. The build tree is kept in the stage so stream-services
# can lift the native/examples streaming binaries straight out of it.
FROM ubuntu:24.04 AS doppler-build
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
RUN cmake -B build -S . -DBUILD_PYTHON=OFF -DCMAKE_BUILD_TYPE=Release \
 && cmake --build build -j"$(nproc)" \
 && cmake --install build --prefix /opt/doppler

# ── Stage 2: the dev base shared by sdk + downstream-jm ─────────────────────
# doppler is copied in exactly as `cmake --install` laid it out, so /usr/local
# is a real find_package prefix (headers + both libs + cmake config + .pc) —
# that is the C SDK a downstream links.
#
# doppler's PYTHON package is installed separately from PyPI: a real downstream
# uses BOTH faces — it LINKS the C SDK (version-locked, built from source above)
# and IMPORTS the doppler Python API (iqtools' own tests write captures with
# doppler.wfm.Writer and read them back). Only the linked C SDK must be
# byte-locked; the Python package is a test-helper dependency, so it floats at
# latest — which also keeps this build green during a release's version-bump
# window, when the source is briefly ahead of PyPI. numpy + pytest ride in as
# doppler-dsp's deps / a one-liner; PEP-668 is waived with --break-system-packages
# since this is a single-purpose image, not a distro.
FROM ubuntu:24.04 AS dev-base
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential cmake pkg-config git ca-certificates curl \
        python3 python3-dev python3-pip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=doppler-build /opt/doppler/ /usr/local/
RUN ldconfig
RUN pip install --no-cache-dir --break-system-packages \
        numpy pytest doppler-dsp
# uv → /usr/local/bin; the pinned jm as a uv tool, also on PATH. Keep this
# version in lock-step with just-makeit.toml's jm_version.
ARG JM_VERSION=0.43.0
ENV UV_INSTALL_DIR=/usr/local/bin \
    UV_TOOL_BIN_DIR=/usr/local/bin \
    UV_TOOL_DIR=/opt/uv-tools
RUN curl -LsSf https://astral.sh/uv/install.sh | sh \
 && uv tool install --python python3 "just-makeit==${JM_VERSION}"

# ── Target: SDK / develop image ────────────────────────────────────────────
# Every consuming example's SOURCE, nothing pre-built — you drive the builds,
# which is the point. doppler is on the default find_package path, so each
# example configures with no -Ddoppler_DIR.
FROM dev-base AS sdk
COPY examples/ /workspace/examples/
COPY deploy/docker/sdk-README.md /workspace/README.md
WORKDIR /workspace
CMD ["/bin/bash"]

# ── Target: iqtools showcase image ─────────────────────────────────────────
# The flagship downstream project, built and tested against the installed
# doppler the same way `make test-example-downstream` does — then left in
# place so `python3 -c "import iqtools"` works and `just-makeit apply` can
# re-generate the bindings live. Building here is also the image's own smoke
# test: if iqtools ever stops consuming doppler cleanly, this layer fails.
FROM dev-base AS downstream-jm
COPY examples/downstream-jm/ /iqtools/
COPY deploy/docker/downstream-README.md /iqtools/DOCKER-README.md
WORKDIR /iqtools
ENV PYTHONPATH=/iqtools/src
RUN make test
CMD ["/bin/bash"]

# ── Stage 1b: the streaming binaries, built AT THE GLIBC FLOOR ─────────────
# A second builder, deliberately not the ubuntu:24.04 one above. Those three
# binaries are the only artifacts here that get shipped and RUN on a base other
# than the one that compiled them, so they are the only ones that have to hold
# doppler's glibc floor (Makefile GLIBC_MAX, 2.28).
#
# They did not. Built on ubuntu:24.04 (glibc 2.39) and shipped onto
# debian:bookworm-slim (2.36), every compose service died on startup with
#
#   transmitter: libm.so.6: version `GLIBC_2.38' not found
#
# Three symbols pulled the floor up: fmod, re-versioned in libm at 2.38, plus
# __isoc23_sscanf / __isoc23_strtol, which glibc's own headers silently
# redirect sscanf/strtol to from 2.38 onward. None of that is
# architecture-specific — the target was broken everywhere; it just took
# someone actually running `docker compose up` to find out. Static doppler
# linkage does not make a binary static against libc.
#
# The fix is to compile them where the floor lives rather than to raise the
# runtime to meet them, so the base is the SAME toolchain image the
# `glibc-gate` gate uses. One definition of "glibc 2.28", in
# Dockerfile.glibc228, consumed twice — moving the floor means moving that
# base image, and both consumers follow.
FROM ${GLIBC_BASE} AS stream-build
WORKDIR /src
COPY . .
RUN cmake -B build-stream -S . -DBUILD_PYTHON=OFF -DCMAKE_BUILD_TYPE=Release \
 && cmake --build build-stream -j"$(nproc)" \
        --target transmitter receiver spectrum_analyzer

# ── Target: streaming services for docker-compose ──────────────────────────
# The native/examples streaming binaries link doppler statically (doppler_lib_static
# + the folded-in stream tier + nats.c), so this runtime needs no doppler and
# no toolchain — only libc/libm/pthread from the slim base. That holds now
# because stream-build above targets glibc 2.28, comfortably under this base's
# 2.36; the invariant is runtime glibc >= builder glibc, and `make glibc-check`
# now enforces the builder half across every example binary, not just
# libdoppler.so. Binaries land on PATH; docker-compose.yml invokes them by
# bare name.
FROM debian:bookworm-slim AS stream-services
COPY --from=stream-build \
        /src/build-stream/native/examples/transmitter \
        /src/build-stream/native/examples/receiver \
        /src/build-stream/native/examples/spectrum_analyzer \
        /usr/local/bin/
WORKDIR /app
# No ENTRYPOINT: docker-compose sets each service's command explicitly.
